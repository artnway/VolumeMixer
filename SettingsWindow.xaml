<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="VolumeMixer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Volume Mixer Settings">
    <Grid x:Name="SettingsSurface" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" RowDefinitions="*,Auto">
        <Grid.Resources>
            <SolidColorBrush x:Key="TabViewItemSeparator" Color="Transparent"/>
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="{ThemeResource SystemAccentColor}" Opacity="0.18"/>
            <Style x:Key="SettingRow" TargetType="Grid">
                <Setter Property="MinHeight" Value="36"/>
            </Style>
            <Style x:Key="SectionLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Style>
            <Style x:Key="SectionSurface" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="12,4"/>
            </Style>
            <Style x:Key="RowSeparator" TargetType="Border">
                <Setter Property="Height" Value="1"/>
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
            </Style>
            <Style x:Key="CompactSwitch" TargetType="ToggleSwitch">
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Width" Value="48"/>
                <Setter Property="OnContent" Value=""/>
                <Setter Property="OffContent" Value=""/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
            </Style>
        </Grid.Resources>
        <TabView x:Name="SettingsTabs" Margin="0,4,0,0" SelectedIndex="0"
                 IsAddTabButtonVisible="False" CanDragTabs="False" CanReorderTabs="False"
                 TabWidthMode="SizeToContent" SelectionChanged="SettingsTabs_SelectionChanged">
            <TabViewItem Header="General" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" Loaded="SettingsPage_Loaded">
                    <StackPanel Padding="16,12,16,12" Spacing="8">
                        <Border Style="{StaticResource SectionSurface}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRow}" ColumnSpacing="12" ColumnDefinitions="*,Auto">
                            <TextBlock Text="Show mixer controls in" VerticalAlignment="Center"/>
                            <ComboBox x:Name="IntegrationComboBox" Grid.Column="1" Width="156" VerticalAlignment="Center" AutomationProperties.Name="Show mixer controls in">
                                <ComboBoxItem Content="Tray only"/>
                                <ComboBoxItem Content="Taskbar only"/>
                                <ComboBoxItem Content="Taskbar + Tray"/>
                            </ComboBox>
                        </Grid>
                        <Border Style="{StaticResource RowSeparator}"/>
                        <Grid Style="{StaticResource SettingRow}" ColumnSpacing="12" ColumnDefinitions="*,Auto">
                            <TextBlock Text="Launch at sign-in" VerticalAlignment="Center"/>
                            <ToggleSwitch x:Name="StartupToggle" Grid.Column="1" Style="{StaticResource CompactSwitch}" AutomationProperties.Name="Launch at sign-in"/>
                        </Grid>
                        <Border Style="{StaticResource RowSeparator}"/>
                        <Grid Style="{StaticResource SettingRow}" ColumnSpacing="12" ColumnDefinitions="*,Auto">
                            <TextBlock Text="Start with the mixer hidden" VerticalAlignment="Center"/>
                            <ToggleSwitch x:Name="StartMinimizedToggle" Grid.Column="1" Style="{StaticResource CompactSwitch}" AutomationProperties.Name="Start with the mixer hidden"/>
                        </Grid>
                        <Border Style="{StaticResource RowSeparator}"/>
                        <Grid Style="{StaticResource SettingRow}" ColumnSpacing="12" ColumnDefinitions="*,Auto">
                            <TextBlock Text="Hide mixer when focus moves away" VerticalAlignment="Center"/>
                            <ToggleSwitch x:Name="HideOnFocusToggle" Grid.Column="1" Style="{StaticResource CompactSwitch}" AutomationProperties.Name="Hide mixer when focus moves away"/>
                        </Grid>
                        <Border Style="{StaticResource RowSeparator}"/>
                        <Grid Style="{StaticResource SettingRow}" ColumnSpacing="12" ColumnDefinitions="*,Auto">
                            <TextBlock Text="Remember window position" VerticalAlignment="Center"/>
                            <ToggleSwitch x:Name="RememberPositionToggle" Grid.Column="1" Style="{StaticResource CompactSwitch}" AutomationProperties.Name="Remember window position"/>
                        </Grid>
                        <Border Style="{StaticResource RowSeparator}"/>
                        <Grid Style="{StaticResource SettingRow}" ColumnSpacing="12" ColumnDefinitions="*,Auto">
                            <TextBlock Text="Keep the pinned mixer on top" VerticalAlignment="Center"/>
                            <ToggleSwitch x:Name="PinnedTopToggle" Grid.Column="1" Style="{StaticResource CompactSwitch}" AutomationProperties.Name="Keep the pinned mixer on top"/>
                        </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="Taskbar" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" Loaded="SettingsPage_Loaded">
                    <StackPanel Padding="16,12,16,12" Spacing="8">
                        <Border Style="{StaticResource SectionSurface}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRow}" ColumnSpacing="8" ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Text="Taskbar indicator" VerticalAlignment="Center"/>
                            <Grid Grid.Column="1" Width="24" Height="24" VerticalAlignment="Center" ToolTipService.ToolTip="Preview at full volume">
                                <Ellipse Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.5"/>
                                <FontIcon x:Name="TaskbarSpeakerPreview" Glyph="&#xE995;" FontSize="12"/>
                                <TextBlock x:Name="TaskbarNumberPreview" Text="100" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                            <ComboBox x:Name="TaskbarIndicatorComboBox" Grid.Column="2" Width="156" VerticalAlignment="Center"
                                      AutomationProperties.Name="Taskbar indicator" SelectionChanged="TaskbarIndicator_SelectionChanged">
                                <ComboBoxItem Content="Device icon in ring"/>
                                <ComboBoxItem Content="Number in ring"/>
                            </ComboBox>
                        </Grid>
                        <Border Style="{StaticResource RowSeparator}"/>
                        <Grid Style="{StaticResource SettingRow}" ColumnSpacing="12" ColumnDefinitions="*,Auto">
                            <TextBlock Text="Always show speaker" VerticalAlignment="Center"/>
                            <ToggleSwitch x:Name="AlwaysSpeakerToggle" Grid.Column="1" Style="{StaticResource CompactSwitch}"
                                          AutomationProperties.Name="Always show speaker"
                                          ToolTipService.ToolTip="Keep the speaker icon when a headphone output is selected."/>
                        </Grid>
                        <Border Style="{StaticResource RowSeparator}"/>
                        <Grid Style="{StaticResource SettingRow}" ColumnSpacing="12" ColumnDefinitions="*,Auto">
                            <TextBlock Text="Use mouse wheel on the taskbar widget" VerticalAlignment="Center"/>
                            <ToggleSwitch x:Name="TaskbarWheelToggle" Grid.Column="1" Style="{StaticResource CompactSwitch}" AutomationProperties.Name="Use mouse wheel on the taskbar widget"/>
                        </Grid>
                        <Border Style="{StaticResource RowSeparator}"/>
                        <Grid Style="{StaticResource SettingRow}" ColumnSpacing="12" ColumnDefinitions="*,Auto">
                            <TextBlock Text="Show 0 in number mode while muted" VerticalAlignment="Center"/>
                            <ToggleSwitch x:Name="MutedVolumeToggle" Grid.Column="1" Style="{StaticResource CompactSwitch}" AutomationProperties.Name="Show 0 in number mode while muted"/>
                        </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="Mixer" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" Loaded="SettingsPage_Loaded">
                    <StackPanel Padding="16,12,16,12" Spacing="8">
                        <TextBlock Text="Appearance" Style="{StaticResource SectionLabel}"/>
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="12">
                            <ComboBox x:Name="ThemeComboBox" Header="Theme" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="System"/>
                                <ComboBoxItem Content="Light"/>
                                <ComboBoxItem Content="Dark"/>
                            </ComboBox>
                            <NumberBox x:Name="WheelStepBox" Grid.Column="1" Header="Wheel step (%)" Minimum="1" Maximum="20" SpinButtonPlacementMode="Inline"/>
                            <NumberBox x:Name="ChannelWidthBox" Grid.Row="1" Header="Channel width (DIP)" Minimum="56" Maximum="72" SmallChange="4" SpinButtonPlacementMode="Inline"/>
                            <NumberBox x:Name="FaderHeightBox" Grid.Row="1" Grid.Column="1" Header="Track length" Minimum="128" Maximum="160" SmallChange="4"
                                       SpinButtonPlacementMode="Inline" ToolTipService.ToolTip="Makes the vertical tracks and the mixer window taller or shorter."/>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <CheckBox x:Name="MetersToggle" Content="Show audio activity" MinWidth="0"/>
                            <CheckBox x:Name="ChannelPercentagesToggle" Grid.Column="1" Content="Show volume per channel"
                                      AutomationProperties.Name="Show volume under each channel" MinWidth="0"/>
                        </Grid>
                        <TextBlock Text="Background" Style="{StaticResource SectionLabel}"/>
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                            <ComboBox x:Name="MixerBackdropBox" Grid.ColumnSpan="2" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Background material" SelectionChanged="MixerBackdropBox_SelectionChanged">
                                <ComboBoxItem Content="Mica Alt"/>
                                <ComboBoxItem Content="Acrylic"/>
                                <ComboBoxItem Content="Clear glass"/>
                                <ComboBoxItem Content="Liquid glass"/>
                            </ComboBox>
                            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <TextBlock Text="Opacity" VerticalAlignment="Center"/>
                                <Slider x:Name="GlassOpacityBox" Grid.Column="1" Minimum="0" Maximum="100" StepFrequency="1"
                                        AutomationProperties.Name="Background opacity (%)" ValueChanged="GlassSlider_ValueChanged"
                                        ToolTipService.ToolTip="0% shows the backdrop. 100% uses a solid background."/>
                                <TextBlock x:Name="OpacityValue" Grid.Column="2" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Button Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="Tint color">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Rectangle x:Name="GlassTintSwatch" Width="16" Height="16" RadiusX="4" RadiusY="4"
                                               Stroke="{ThemeResource DividerStrokeColorDefaultBrush}" StrokeThickness="1"/>
                                    <TextBlock Text="Tint color"/>
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout x:Name="GlassTintFlyout" Placement="Right" ShouldConstrainToRootBounds="False">
                                        <StackPanel Width="272" Spacing="8">
                                            <TextBlock Text="Tint color" FontWeight="SemiBold"/>
                                            <ColorPicker x:Name="GlassTintPicker" IsAlphaEnabled="False" IsColorPreviewVisible="False"
                                                         IsMoreButtonVisible="False" ColorSpectrumComponents="SaturationValue"
                                                         ColorChanged="GlassTintPicker_ColorChanged" Loaded="GlassTintPicker_Loaded"/>
                                            <Button Content="Use automatic color" HorizontalAlignment="Stretch" Click="ResetGlassTint_Click"/>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                        <Grid x:Name="FrostRow" Visibility="Collapsed" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <TextBlock Text="Frost" VerticalAlignment="Center"/>
                            <Slider x:Name="GlassFrostBox" Grid.Column="1" Minimum="0" Maximum="100" StepFrequency="1"
                                    AutomationProperties.Name="Glass frost (%)" ValueChanged="GlassSlider_ValueChanged"
                                    ToolTipService.ToolTip="Controls how much the live background is blurred."/>
                            <TextBlock x:Name="FrostValue" Grid.Column="2" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="GlassCaptureNote" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Windows omits the mixer from screen captures in Liquid glass mode."/>
                        <Button x:Name="RestoreHiddenButton" Content="Restore hidden channels" Click="RestoreHiddenButton_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="Devices" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" Loaded="SettingsPage_Loaded">
                    <StackPanel Padding="16,12,16,12" Spacing="8">
                        <ComboBox x:Name="DeviceBox" Header="Playback device" HorizontalAlignment="Stretch" SelectionChanged="DeviceBox_SelectionChanged"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <CheckBox x:Name="FavoriteDevice" Content="Favorite" MinWidth="0" Click="FavoriteDevice_Click"/>
                                <CheckBox x:Name="HiddenDevice" Content="Hide from switcher" MinWidth="0" Click="HiddenDevice_Click"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <Button x:Name="MoveDeviceUp" Width="32" Height="32" Padding="0" AutomationProperties.Name="Move earlier"
                                        ToolTipService.ToolTip="Move earlier" Click="MoveDeviceUp_Click">
                                    <FontIcon Glyph="&#xE74A;" FontSize="14"/>
                                </Button>
                                <Button x:Name="MoveDeviceDown" Width="32" Height="32" Padding="0" AutomationProperties.Name="Move later"
                                        ToolTipService.ToolTip="Move later" Click="MoveDeviceDown_Click">
                                    <FontIcon Glyph="&#xE74B;" FontSize="14"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Playback roles" Style="{StaticResource SectionLabel}"/>
                        <Border Style="{StaticResource SectionSurface}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="20">
                                    <CheckBox x:Name="ConsoleRole" Content="Console" MinWidth="0"/>
                                    <CheckBox x:Name="MultimediaRole" Content="Multimedia" MinWidth="0"/>
                                    <CheckBox x:Name="CommunicationsRole" Content="Communications" MinWidth="0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="Shortcuts" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" Loaded="SettingsPage_Loaded">
                    <StackPanel Padding="16,12,16,12" Spacing="8">
                        <Border Style="{StaticResource SectionSurface}">
                            <StackPanel x:Name="HotkeyPanel" Spacing="4"/>
                        </Border>
                        <TextBlock Text="Select a field to record. Delete clears the shortcut." FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
        </TabView>
        <Border x:Name="SettingsFooter" Grid.Row="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel Padding="16,8" Spacing="8">
                <TextBlock x:Name="HotkeyError" Visibility="Collapsed" TextWrapping="Wrap"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Width="76" Height="32" Content="OK" Click="SaveButton_Click"/>
                    <Button Width="76" Height="32" Content="Cancel" Click="CancelButton_Click"/>
                    <Button x:Name="ApplyButton" Width="76" Height="32" Content="Apply" Style="{StaticResource AccentButtonStyle}" Click="ApplyButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>

